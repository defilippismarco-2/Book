{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {"type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/controllo-stile.py"},
          {"type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/registro-modifiche.py"}
        ]
      }
    ]
  }
}
